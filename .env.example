# ---------------------------------------------------------------------------
# Email (password-reset codes, notices)
#
# With NO EMAIL_HOST_USER the app uses the console backend: emails are printed in
# the terminal that runs `manage.py runserver` and are NEVER delivered to an inbox.
# To send real email, fill in the SMTP block below. For Gmail, enable 2-Step
# Verification and create an "App password" (https://myaccount.google.com/apppasswords);
# use that 16-character password here, not your normal Gmail password.
# Then test with:  python manage.py send_test_email you@example.com
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=riakgugwey@gmail.com
EMAIL_HOST_PASSWORD=lobk cjbc qqer unpl
# DEFAULT_FROM_EMAIL defaults to EMAIL_HOST_USER when it is set
PASSWORD_RESET_CODE_MINUTES=15

